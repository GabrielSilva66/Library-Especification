cd spec
in colecao-usuarios.mod
cd ..

-- ============================================================
-- Módulo auxiliar da prova
-- ============================================================
mod! PROVA-COLECAO-USUARIOS {
  protecting(COLECAO-USUARIOS)

  pred invValido       : ConjuntoUsuarios
  pred lemaPertenceRemover : UsuarioId UsuarioId ConjuntoUsuarios
  pred lemaNaoPertenceRemover : UsuarioId UsuarioId ConjuntoUsuarios

  var  US      : ConjuntoUsuarios
  vars ID1 ID2 : UsuarioId

  -- Invariante da coleção de usuários
  eq invValido(US) = idsUnicos?(US) and todosValidos?(US) .

  -- Lemas auxiliares:
  eq lemaPertenceRemover(ID1, ID2, US) = 
    (pertence?(ID2, US) and not (ID1 == ID2)) 
    implies pertence?(ID2, removerUsuario(ID1, US)) .

  eq lemaNaoPertenceRemover(ID1, ID2, US) = 
    (not pertence?(ID1, US)) 
    implies (not pertence?(ID1, removerUsuario(ID2, US))) .
}

-- ============================================================
-- [1] LEMA: Remover um usuário da coleção de usuários não 
-- afeta os diferentes
-- ============================================================
-- ============================================================
-- [1] Caso Base: US = iniciarColecao = vazioUsuarios
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2  : -> UsuarioId .

  -- Hipóteses
  eq (id1 == id2) = false .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, vazioUsuarios) .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (1): id1 == id(u) and id2 in u us'
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)       = false .
  eq (id1 == id(u))     = true .
  eq (id2 == id(u))     = false .
  eq pertence?(id2, us') = true .

  -- Hipótese da indução:
  eq pertence?(id2, removerUsuario(id1, us')) = true .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (2): id1 == id(u) and id2 not in u us'
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)        = false .
  eq (id1 == id(u))      = true .
  eq (id2 == id(u))      = false .
  eq pertence?(id2, us') = false .
  
  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (3): id1 != id(u) and id2 in u us' and 
-- id2 == id(u)
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)             = false .
  eq (id1 == id(u))           = false .
  eq (id2 == id(u))           = true .
  eq pertence?(id2, us') = false .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (4): id1 != id(u) and id2 in u us' and 
-- id2 != id(u)
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)             = false .
  eq (id1 == id(u))           = false .
  eq (id2 == id(u))           = false .
  eq pertence?(id2, us') = true .

  -- Hipótese da indução:
  eq pertence?(id2, removerUsuario(id1, us')) = true .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (5): id1 != id(u) and id2 not in u us'
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)             = false .
  eq (id1 == id(u))           = false .
  eq (id2 == id(u))           = false .
  eq pertence?(id2, us') = false .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [1] Caso Indutivo (6): id1 == id2
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id2)             = true .

  -- Prova:
  set trace on
  red lemaPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [2] LEMA: Se um Usuario não pertence ao colecao-usuarios, remover 
-- qualquer outro Usuario faz com que ele ainda não pertença
-- ============================================================
-- ============================================================
-- [2] Caso Base: A = iniciarColecao = vazioUsuarios
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2  : -> UsuarioId .

  -- Prova:
  set trace on
  red lemaNaoPertenceRemover(id1, id2, vazioUsuarios) .
  set trace off
close

-- ============================================================
-- [2] Caso Indutivo (1): id1 in u us'
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq pertence?(id1, u us') = true .

  -- Prova:
  set trace on
  red lemaNaoPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [2] Caso Indutivo (2): id1 not in u us' and id2 == id(u)
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id(u))           = false .
  eq (id2 == id(u))           = true .
  eq pertence?(id1, us') = false .

  -- Hipótese da indução:
  eq pertence?(id1, removerUsuario(id2, us')) = false .

  -- Prova:
  set trace on
  red lemaNaoPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [2] Caso Indutivo (3): id1 not in u us' and id2 != id(u)
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  -- Operandos:
  ops id1 id2 : -> UsuarioId .
  op  us'     : -> ConjuntoUsuarios .
  op  u       : -> Usuario .

  -- Hipóteses:
  eq (id1 == id(u))           = false .
  eq (id2 == id(u))           = false .
  eq pertence?(id1, us') = false .

  -- Hipótese da indução:
  eq pertence?(id1, removerUsuario(id2, us')) = false .

  -- Prova:
  set trace on
  red lemaNaoPertenceRemover(id1, id2, u us')  .
  set trace off
close

-- ============================================================
-- [3] INVARIANTE: Validade da coleção de usuários é preservada
-- ============================================================
-- ============================================================
-- [3] Caso Base: US = iniciarColecao = vazioUsuarios
-- ============================================================
open PROVA-COLECAO-USUARIOS .
  set trace on
  red invValido(iniciarColecao) .
  set trace off
close

-- ============================================================
-- [3] Preservação por adicionarUsuario(u, us)
-- ============================================================
-- Caso 1: Usuário ainda não pertence e é válido (u us)
open PROVA-COLECAO-USUARIOS .
  op u  : -> Usuario .
  op us : -> ConjuntoUsuarios .

  -- Hipóteses:
  eq idsUnicos?(us) = true .
  eq todosValidos?(us) = true .

  -- Condições:
  eq pertence?(id(u), us) = false .
  eq valido?(u) = true .

  set trace on
  red invValido(adicionarUsuario(u, us)) .
  set trace off
close

-- Caso 2: Usuário ainda não pertence e é invalido (us)
open PROVA-COLECAO-USUARIOS .
  op u  : -> Usuario .
  op us : -> ConjuntoUsuarios .

  -- Hipóteses:
  eq idsUnicos?(us) = true .
  eq todosValidos?(us) = true .

  -- Condições:
  eq pertence?(id(u), us) = false .
  eq valido?(u) = false .

  set trace on
  red invValido(adicionarUsuario(u, us)) .
  set trace off
close

-- Caso 3: Usuário já pertence (us)
open PROVA-COLECAO-USUARIOS .
  op u  : -> Usuario .
  op us : -> ConjuntoUsuarios .

  -- Hipóteses:
  eq idsUnicos?(us) = true .
  eq todosValidos?(us) = true .

  -- Condições:
  eq pertence?(id(u), us) = true .

  set trace on
  red invValido(adicionarUsuario(u, us)) .
  set trace off
close

-- ============================================================
-- [3] Preservação por removerUsuario(id0, us)
-- ============================================================
-- Caso Base: US = iniciarColecao = vazioUsuarios
open PROVA-COLECAO-USUARIOS .
  op id0 : -> UsuarioId .

  set trace on
  red invValido(removerUsuario(id0, iniciarColecao)) .
  set trace off
close

-- Caso indutivo: US = u us', com id(u) == id0
open PROVA-COLECAO-USUARIOS .
  op id0 : -> UsuarioId .
  op u   : -> Usuario .
  op us' : -> ConjuntoUsuarios .

  -- Hipóteses:
  eq idsUnicos?(removerUsuario(id0, us')) = true .
  eq todosValidos?(removerUsuario(id0, us')) = true .

  -- Condição do caso:
  eq (id0 == id(u)) = true .

  set trace on
  red invValido(removerUsuario(id0, u us')) .
  set trace off
close

-- Caso indutivo: US = u us', com id(u) != id0
open PROVA-COLECAO-USUARIOS .
  op id0 : -> UsuarioId .
  op u   : -> Usuario .
  op us' : -> ConjuntoUsuarios .

  -- De invValido(u us') = true:
  eq valido?(u) = true . 

  -- Hipótese de Indução (sobre us'):
  eq idsUnicos?(removerUsuario(id0, us')) = true .
  eq todosValidos?(removerUsuario(id0, us')) = true .

  -- Consequência de lemaNaoPertence (pois pertence?(id(u), us') = false):
  eq pertence?(id(u), removerUsuario(id0, us')) = false .

  -- Condição do caso:
  eq (id0 == id(u)) = false .

  set trace on
  red invValido(removerUsuario(id0, u us')) .
  set trace off
close
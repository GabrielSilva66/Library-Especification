-- ============================================================
-- demo.cafe: Especificação BIBLIOTECA em ação (Cenário Real)
--
-- Demonstração prática do ciclo de vida da biblioteca:
-- cadastro de acervo, registro de usuários, empréstimos, devoluções,
-- consultas de catálogo, bloqueio de operações inválidas e
-- preservação dos invariantes globais.
--
-- Execução: cafeobj -batch demo.cafe
-- ============================================================
require biblioteca biblioteca.mod

mod! DEMO-BIBLIOTECA {
  protecting(BIBLIOTECA)

  -- Identificadores de exemplares e obras catalogadas
  ops l1 l2 l3 l4 l5 l6 lx : -> LivroId .
  ops obAlg obCC obComp obAlgor obES : -> ObraId .

  -- Identificadores de usuários
  ops u1 u2 u3 u4 ux : -> UsuarioId .

  -- Exemplares de Livros físicos
  -- Nota: l1 e l2 são dois exemplares físicos da mesma obra (obAlg)
  ops livro1 livro2 livro3 livro4 livro5 livro6 : -> Livro .
  op livroInvalido : -> Livro .

  eq livro1 = livro(l1, obAlg,   "Estruturas Algebricas",  "Valdigleis S. Costa", 2026) .
  eq livro2 = livro(l2, obAlg,   "Estruturas Algebricas",  "Valdigleis S. Costa", 2026) .
  eq livro3 = livro(l3, obCC,    "Clean Code",             "Robert C. Martin",    2008) .
  eq livro4 = livro(l4, obComp,  "Compiladores",           "Alfred Aho",          2006) .
  eq livro5 = livro(l5, obAlgor, "Algoritmos: Teoria e Pratica", "Thomas Cormen", 2009) .
  eq livro6 = livro(l6, obES,    "Engenharia de Software", "Ian Sommerville",     2011) .
  eq livroInvalido = livro(l1, obAlg, "", "", 0) .

  -- Usuários do sistema
  ops ana bruno carla davi : -> Usuario .
  op usuarioInvalido : -> Usuario .

  eq ana   = usuario(u1, "Ana Souza",     "ana@email.com") .
  eq bruno = usuario(u2, "Bruno Lima",    "bruno@email.com") .
  eq carla = usuario(u3, "Carla Mendes",  "carla@email.com") .
  eq davi  = usuario(u4, "Davi Oliveira", "davi@email.com") .
  eq usuarioInvalido = usuario(u1, "Fantasma", "") .

  -- Biblioteca inicial (biblioteca0):
  -- Começa vazia e recebe o cadastro inicial de 5 livros e 4 usuários
  op biblioteca0 : -> Biblioteca .
  eq biblioteca0 =
    registrarLivro(livro5,
    registrarLivro(livro4,
    registrarLivro(livro3,
    registrarLivro(livro2,
    registrarLivro(livro1,
    registrarUsuario(davi,
    registrarUsuario(carla,
    registrarUsuario(bruno,
    registrarUsuario(ana,
      bibliotecaVazia))))))))) .

  -- Biblioteca após movimentações de uma semana típica (biblioteca1):
  --   1. Ana pega emprestado o exemplar 1 de Estruturas Algébricas (l1)
  --   2. Bruno pega emprestado Clean Code (l3)
  --   3. Carla pega emprestado Compiladores (l4)
  --   4. Davi tenta pegar o exemplar 1 (já emprestado para Ana) -> ignorado/preservado
  --   5. Davi pega emprestado o exemplar 2 da mesma obra (l2) -> sucesso!
  --   6. Ana devolve o exemplar 1 (l1) -> l1 torna-se disponível novamente
  --   7. Um novo livro (livro6: Engenharia de Software) é catalogado e inserido
  op biblioteca1 : -> Biblioteca .
  eq biblioteca1 =
    registrarLivro(livro6,
      devolverLivro(l1, u1,
        emprestarLivro(l2, u4,
          emprestarLivro(l1, u4,
            emprestarLivro(l4, u3,
              emprestarLivro(l3, u2,
                emprestarLivro(l1, u1,
                  biblioteca0))))))) .
}

select DEMO-BIBLIOTECA .

-- (1) Estado inicial da biblioteca
red qtdAcervo(biblioteca0) .                                  -- 5 livros no total
red qtdUsuarios(biblioteca0) .                                -- 4 usuários cadastrados
red qtdEmprestimos(biblioteca0) .                             -- 0 empréstimos
red qtdDisponiveis(biblioteca0) .                             -- 5 livros disponíveis

-- (2) Tentativa de cadastro com dados duplicados ou inválidos (rejeitados)
red qtdAcervo(registrarLivro(livro1, biblioteca0)) .          -- 5 (não duplica l1)
red qtdAcervo(registrarLivro(livroInvalido, biblioteca0)) .   -- 5 (rejeita livro inválido)
red qtdUsuarios(registrarUsuario(ana, biblioteca0)) .         -- 4 (não duplica Ana)
red qtdUsuarios(registrarUsuario(usuarioInvalido, biblioteca0)) . -- 4 (rejeita e-mail vazio)

-- (3) Consultas de catálogo no estado inicial
red buscarLivro(l3, biblioteca0) .                            -- livro3 ("Clean Code")
red buscarLivro(lx, biblioteca0) .                            -- livroInexistente
red qtdAcervo(buscarTitulo("Estruturas Algebricas", biblioteca0)) . -- 2 exemplares
red qtdExemplaresObra(obAlg, biblioteca0) .                   -- 2 exemplares de obAlg
red qtdAcervo(tituloDeAutor("Robert C. Martin", biblioteca0)) . -- 1 exemplar

-- (4) Estado da biblioteca após o ciclo de movimentação (biblioteca1)
red qtdAcervo(biblioteca1) .                                  -- 6 (5 iniciais + livro6)
red qtdEmprestimos(biblioteca1) .                             -- 3 empréstimos ativos (l3 com Bruno, l4 com Carla, l2 com Davi)
red qtdDisponiveis(biblioteca1) .                             -- 3 disponíveis (l1 devolvido, l5 livre, l6 recém-chegado)
red (qtdDisponiveis(biblioteca1) + qtdEmprestimos(biblioteca1)) == qtdAcervo(biblioteca1) . -- true (conservação)

-- (5) Verificação de disponibilidade e posse de exemplares
red emprestado?(l1, biblioteca1) .                            -- false (Ana devolveu l1)
red disponivel?(l1, biblioteca1) .                            -- true (l1 está na prateleira)
red emprestado?(l2, biblioteca1) .                            -- true (l2 está com Davi)
red disponivel?(l2, biblioteca1) .                            -- false
red temLivro?(u4, l2, biblioteca1) .                          -- true (Davi possui o exemplar l2)
red temLivro?(u2, l3, biblioteca1) .                          -- true (Bruno possui Clean Code)
red temLivro?(u1, l1, biblioteca1) .                          -- false (Ana já devolveu)

-- (6) Operações inválidas bloqueadas pelas regras de negócio
-- Bruno tenta pegar l2 que já está emprestado a Davi: recusado, mantém 3 empréstimos
red qtdEmprestimos(emprestarLivro(l2, u2, biblioteca1)) .     -- 3
-- Emprestar livro que não existe no acervo: recusado
red qtdEmprestimos(emprestarLivro(lx, u1, biblioteca1)) .     -- 3
-- Emprestar para usuário não cadastrado: recusado
red qtdEmprestimos(emprestarLivro(l1, ux, biblioteca1)) .     -- 3
-- Ana tenta devolver o livro que está com Davi (l2): recusado
red qtdEmprestimos(devolverLivro(l2, u1, biblioteca1)) .      -- 3
-- Tentativa de remover do acervo livro que está emprestado (l2 com Davi): recusado
red qtdAcervo(removerLivro(l2, biblioteca1)) .                -- 6 (l2 não pode ser descartado)
-- Tentativa de remover usuário que possui empréstimo ativo (Davi tem l2): recusado
red qtdUsuarios(removerUsuario(u4, biblioteca1)) .            -- 4 (Davi não pode ser descadastrado)
-- Remoção válida de livro disponível (livro6): sucesso
red qtdAcervo(removerLivro(l6, biblioteca1)) .                -- 5
-- Remoção válida de usuário sem empréstimo (Ana): sucesso
red qtdUsuarios(removerUsuario(u1, biblioteca1)) .            -- 3

-- (7) Invariantes de consistência global
red valido?(biblioteca0) .                                    -- true (estado inicial íntegro)
red valido?(biblioteca1) .                                    -- true (estado após operações íntegro)
-- Estado montado à mão violando unicidade de empréstimo (mesmo livro para dois usuários)
red valido?(biblioteca(livro1, ana bruno, emprestar(l1, u1) emprestar(l1, u2))) . -- false
